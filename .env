# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Authentication
JWT_SECRET=production_super_secret_certificate_key_change_in_prod_2026
JWT_EXPIRES_IN=7d

# Official Club Website Placeholder & Configuration
# This URL is linked on all official certificates and on the public verification page
OFFICIAL_CLUB_WEBSITE_URL=https://imrdaisc.vercel.app/

# Public Base URL for Verification Links & QR Codes
