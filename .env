# Database Storage Path (SQLite)
DATABASE_PATH=./data/certificates.db

# Storage path for uploads and generated exports
STORAGE_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
