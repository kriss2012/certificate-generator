# ==============================================================================
# Certificate Generation & Verification System - Environment Configuration
# ==============================================================================

# Server Configuration
# In Railway: PORT is assigned automatically by Railway; do not hardcode in Railway settings.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Security & Authentication (MANDATORY IN PRODUCTION)
# Generate a secure 64-character random string for production deployments
JWT_SECRET=replace_with_a_secure_production_random_secret_string_32_plus_chars
JWT_EXPIRES_IN=7d

# Official Club Website Placeholder & Configuration
# This URL is linked on all official certificates and on the public verification page
OFFICIAL_CLUB_WEBSITE_URL=https://rcpimrd.ac.in

# Public Base URL for Verification Links & QR Codes
# In Railway: If unset, the system will automatically detect https://${RAILWAY_PUBLIC_DOMAIN}
# Or set explicitly to your custom domain: e.g. https://certificates.yourdomain.com
BASE_URL=

# Database Storage Path (SQLite)
# In Railway: Attach a Persistent Volume mounted at /app/data to persist SQLite across redeploys!
# Path within the container:
DATABASE_PATH=/app/data/certificates.db

# Storage path for uploads and generated exports
STORAGE_PATH=/app/uploads

# Python executable path (defaults to 'python3' on Linux / Docker, 'python' on Windows)
PYTHON_PATH=python3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
